// The names an image may import, read from the specification this package is
// built against (openkal's SURFACE.txt), as the lines libokrun binds:
// surface.inc (every interface but openkal.space) and surface_space.inc
// (openkal.space, bound where the implementation provides it). Generated at
// every build from the specification itself, so the list cannot fall behind it.
#include <cstdio>
#include <cstdlib>
#include <filesystem>
#include <fstream>
#include <set>
#include <string>
#include <vector>

int main() {
    const char* dep = std::getenv("MCPP_DEP_OPENKAL_DIR");
    const char* out = std::getenv("MCPP_OUT_DIR");
    if (!dep || !out) {
        std::puts("mcpp:warning=the openkal dependency's directory is not known; no binding list");
        return 1;
    }
    const std::filesystem::path surface = std::filesystem::path(dep) / "SURFACE.txt";
    std::ifstream in(surface);
    if (!in) {
        std::printf("mcpp:warning=%s cannot be read\n", surface.string().c_str());
        return 1;
    }
    // The arguments and the image's own name are the runner's to answer (SPEC
    // 12.3); a context's entry is entered in the image's convention through a
    // box; every other name is the implementation's.
    const std::set<std::string> own{ "kal_env_arg_count", "kal_env_arg", "kal_env_image", "kal_env_loader" };
    const std::set<std::string> callbacks{ "kal_task_start", "kal_task_start_sized" };
    std::vector<std::string> main_names, space_names;
    std::string group, line;
    while (std::getline(in, line)) {
        if (line.rfind("# openkal.", 0) == 0) { group = line.substr(2, line.find_first_of(" \t", 2) - 2); continue; }
        if (line.rfind("kal_", 0) != 0) continue;
        while (!line.empty() && (line.back() == '\r' || line.back() == ' ')) line.pop_back();
        (group == "openkal.space" ? space_names : main_names).push_back(line);
    }
    auto emit = [&](const char* file, const std::vector<std::string>& names) {
        std::ofstream o(std::filesystem::path(out) / file);
        o << "// Generated by openkal-run's build.mcpp from " << surface.generic_string() << ".\n";
        for (const auto& n : names)
            o << (own.contains(n) ? "OKRUN_OWN(" : callbacks.contains(n) ? "OKRUN_CALLBACK(" : "OKRUN_BIND(") << n << ")\n";
    };
    emit("surface.inc", main_names);
    emit("surface_space.inc", space_names);
    std::printf("mcpp:include-dir=%s\n", out);
    std::printf("mcpp:rerun-if-changed=%s\n", surface.string().c_str());
    return 0;
}

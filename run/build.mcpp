// The names an image may import, read from the specification this package is
// built against (openkal's SURFACE.txt), as the lines libokrun binds:
// surface.inc (every interface but openkal.space) and surface_space.inc
// (openkal.space). Generated at every build from the specification itself, so
// the list cannot fall behind it.
//
// BOUND BY WHAT THE IMPLEMENTATION PROVIDES (0.6, mcpp >= 2026.11.10.1): the
// interfaces the resolved implementation states (`provides-interfaces', read
// from MCPP_KERNEL_ABI_INTERFACES) are bound; a name of any other interface is
// listed without an address, so that the runner refers to nothing an
// implementation does not have, and an image that requires the interface is
// refused at load (SPEC 12.4). An empty list is "unknown": every interface is
// bound, as before. provided.inc states the same set to the runner's sources.
#include <cctype>
#include <cstdio>
#include <cstdlib>
#include <filesystem>
#include <fstream>
#include <map>
#include <set>
#include <string>
#include <vector>

int main() {
    const char* dep = std::getenv("MCPP_DEP_OPENKAL_DIR");
    const char* out = std::getenv("MCPP_OUT_DIR");
    if (!dep || !out) {
        std::puts("mcpp:warning=the openkal dependency's directory is not known; no binding list");
        return 1;
    }
    const std::filesystem::path surface = std::filesystem::path(dep) / "SURFACE.txt";
    std::ifstream in(surface);
    if (!in) {
        std::printf("mcpp:warning=%s cannot be read\n", surface.string().c_str());
        return 1;
    }
    // The arguments and the image's own name are the runner's to answer (SPEC
    // 12.3); a context's entry is entered in the image's convention through a
    // box; every other name is the implementation's. Since 0.2 the runner
    // also answers openkal.prof and openkal.debug, which are a loader's (SPEC
    // 12.3), the word of interfaces (the implementation's and those two), and
    // the program's end (where a measurement records what it measured).
    std::set<std::string> own{ "kal_env_arg_count", "kal_env_arg", "kal_env_image", "kal_env_loader",
                               "kal_interfaces", "kal_exit", "kal_abort" };
    const std::set<std::string> callbacks{ "kal_task_start", "kal_task_start_sized" };
    std::vector<std::string> main_names, space_names, groups;
    std::map<std::string, std::string> group_of;
    std::string group, line;
    while (std::getline(in, line)) {
        if (line.rfind("# openkal.", 0) == 0) {
            group = line.substr(2, line.find_first_of(" \t", 2) - 2);
            groups.push_back(group);
            continue;
        }
        if (line.rfind("kal_", 0) != 0) continue;
        while (!line.empty() && (line.back() == '\r' || line.back() == ' ')) line.pop_back();
        if (group == "openkal.prof" || group == "openkal.debug") own.insert(line);
        group_of[line] = group;
        (group == "openkal.space" ? space_names : main_names).push_back(line);
    }

    // The interfaces the implementation provides; none stated is every one.
    std::set<std::string> provided;
    if (const char* list = std::getenv("MCPP_KERNEL_ABI_INTERFACES"); list && *list) {
        std::string item;
        for (const char* c = list;; ++c) {
            if (*c == ';' || *c == '\0') { if (!item.empty()) provided.insert(item); item.clear(); }
            else item += *c;
            if (!*c) break;
        }
    } else {
        provided.insert(groups.begin(), groups.end());
    }
    // The specification's self-description is the implementation's in every
    // case: it has no bit, and every implementation answers it.
    provided.insert("openkal.version");

    auto emit = [&](const char* file, const std::vector<std::string>& names) {
        std::ofstream o(std::filesystem::path(out) / file);
        o << "// Generated by openkal-run's build.mcpp from " << surface.generic_string() << ".\n";
        // The second argument is the name's position, by which a measurement
        // of the calls an image makes (okprof, 0.2) keeps its counts.
        for (std::size_t i = 0; i < names.size(); ++i) {
            const auto& n = names[i];
            // A callback of an interface the implementation does not provide is absent, as
            // its other names are (0.6.3: a context cannot be started where there are none).
            o << (own.contains(n) ? "OKRUN_OWN(" :
                  !provided.contains(group_of[n]) ? "OKRUN_ABSENT(" :
                  callbacks.contains(n) ? "OKRUN_CALLBACK(" : "OKRUN_BIND(")
              << n << ", " << i << ")\n";
        }
    };
    emit("surface.inc", main_names);
    emit("surface_space.inc", space_names);
    {
        // OKRUN_HAS_<INTERFACE> for each interface with a bit, and the word of
        // the provided ones, which the runner intersects with kal_interfaces().
        std::ofstream o(std::filesystem::path(out) / "provided.inc");
        o << "// Generated by openkal-run's build.mcpp: the interfaces the implementation provides.\n";
        std::string word;
        for (const auto& g : groups) {
            if (g == "openkal.version") continue;
            std::string upper;
            for (char c : g.substr(sizeof "openkal." - 1)) upper += static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
            const bool has = provided.contains(g);
            o << "#define OKRUN_HAS_" << upper << " " << (has ? 1 : 0) << "\n";
            if (has) word += (word.empty() ? "" : " | ") + std::string("KAL_IFACE_") + upper;
        }
        o << "#define OKRUN_COMPILED_INTERFACES (" << (word.empty() ? std::string("0") : word) << ")\n";
    }

    // A PERFECT HASH OF EVERY NAME (0.4): okrun_resolve is asked once for
    // each name an image imports, and a comparison with every name in turn
    // made it a pass over the surface for each. A seed is searched for under
    // which no two names share a slot; the runner hashes a name once, reads
    // its slot and compares one name.
    std::vector<std::string> all(main_names);
    all.insert(all.end(), space_names.begin(), space_names.end());
    constexpr unsigned slots = 2048;   // about ten times the names: a seed is found in thousands of trials
    auto hash = [](unsigned seed, const std::string& n) {
        unsigned h = 2166136261u ^ seed;
        for (unsigned char c : n) { h ^= c; h *= 16777619u; }
        return h % slots;
    };
    unsigned seed = 0;
    std::vector<unsigned short> table;
    for (unsigned trial = 1; trial < 1000000; ++trial) {
        table.assign(slots, 0);
        bool clean = true;
        for (std::size_t i = 0; i < all.size() && clean; ++i) {
            auto& slot = table[hash(trial, all[i])];
            if (slot) clean = false; else slot = static_cast<unsigned short>(i + 1);
        }
        if (clean) { seed = trial; break; }
    }
    if (!seed) {
        std::puts("mcpp:warning=no seed hashes the surface without a collision");
        return 1;
    }
    {
        std::ofstream o(std::filesystem::path(out) / "surface_hash.inc");
        o << "// Generated by openkal-run's build.mcpp: a perfect hash of the surface's names.\n";
        o << "inline constexpr unsigned kResolveSeed = " << seed << "u;\n";
        o << "inline constexpr unsigned kResolveSlots = " << slots << "u;\n";
        o << "inline constexpr unsigned long kResolveMain = " << main_names.size() << "u;\n";
        o << "inline constexpr unsigned short kResolveSlot[" << slots << "] = {";
        for (unsigned i = 0; i < slots; ++i) o << (i % 16 == 0 ? "\n    " : " ") << table[i] << ",";
        o << "\n};\n";
    }
    std::printf("mcpp:include-dir=%s\n", out);
    std::printf("mcpp:rerun-if-changed=%s\n", surface.string().c_str());
    return 0;
}
